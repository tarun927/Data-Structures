// kth from end method
var rotateRight = function(head, k) {
    if(head === null) return head;
    let size = 0;
    let temp = head;
    while(temp !== null){
        temp = temp.next;
        size++;
    }
    k = k%size;
    if(k<0) k = size-k;

    let curr = head;
    let kAhead = head;

    for(let i=0; i<k; i++){
        kAhead = kAhead.next;
    }
    while(kAhead.next !== null){
        curr = curr.next;
        kAhead = kAhead.next;
    }
    kAhead.next = head;
    head = curr.next;
    curr.next = null;
    return head;
};


//joining tail to head and cycle method
var rotateRight = function(head, k) {
    if(head === null) return head;
    let size = 0;
    let temp = head;
    while(temp.next !== null){
        temp = temp.next;
        size++;
    }

    temp.next = head;
    size++;

    k = k%size;
    k = size-k;
    for(let i=0; i<k; i++){
        temp = temp.next;
    }
    head = temp.next
    temp.next = null; 
    
    return head;
};
